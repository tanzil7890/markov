{
  "manifestVersion": 2,
  "id": "markov-vscode-default-themes",
  "publisher": "tanzil7890",
  "name": "VS Code Default Themes for Markov",
  "version": "1.0.0",
  "execution": "data",
  "description": "Unofficial ports of VS Code's default color themes: Dark Modern, Light Modern, Dark+ and Light+.",
  "license": "MIT",
  "repository": "https://github.com/tanzil7890/markov-plugins/tree/main/plugins/vscode-default-themes",
  "engines": {
    "markov": ">=1.4.245"
  },
  "contributes": {
    "themes": [
      {
        "id": "vs-code-dark",
        "title": "VS Code Dark+",
        "path": "themes/vs-code-dark.json"
      },
      {
        "id": "vs-code-dark-modern",
        "title": "VS Code Dark Modern",
        "path": "themes/vs-code-dark-modern.json"
      },
      {
        "id": "vs-code-light",
        "title": "VS Code Light+",
        "path": "themes/vs-code-light.json"
      },
      {
        "id": "vs-code-light-modern",
        "title": "VS Code Light Modern",
        "path": "themes/vs-code-light-modern.json"
      }
    ]
  },
  "capabilities": []
}
