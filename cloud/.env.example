# Copy to cloud/.env.local (git-ignored) for `pnpm stack`. Never commit real values.

# Clerk sign-in. Leave both empty to use the built-in test sign-in (local only).
# Clerk dashboard → your application → API keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostgreSQL (Neon). Leave empty to use local SQLite files under cloud/.local/.
# Use Neon's direct connection string, never the "-pooler" one: the servers need
# session locks and LISTEN/NOTIFY, which break through the pooler.
#   neonctl connection-string --project-id <id> --database-name accounts
MARKOV_STACK_ACCOUNTS_DATABASE_URL=
MARKOV_STACK_RELAY_DATABASE_URL=
MARKOV_STACK_SHARING_DATABASE_URL=
MARKOV_STACK_CONNECTOR_DATABASE_URL=

# Slack connector (Socket Mode). Leave empty to use a local test chat instead.
# Create the app from cloud/apps/connector/slack-app-manifest.json, install it to
# your workspace, then copy the Bot User OAuth Token (xoxb-…) and an app-level
# token with the connections:write scope (xapp-…).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional overrides.
# MARKOV_STACK_HOST=127.0.0.1
# MARKOV_STACK_ACCOUNTS_PORT=8790
# MARKOV_STACK_RELAY_PORT=8791
# MARKOV_STACK_SHARING_PORT=8792
# MARKOV_STACK_CONNECTOR_PORT=8793
