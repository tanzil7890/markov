{
  "name": "@markov-cloud/connector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @markov-cloud/postgres-schema build && pnpm --filter @markov-cloud/cloud-database build && pnpm --filter @markov-cloud/push-contract build && pnpm --filter @markov-cloud/connector-contract build",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@markov-cloud/cloud-database": "workspace:*",
    "@markov-cloud/connector-contract": "workspace:*",
    "@slack/socket-mode": "^3.1.0",
    "@slack/web-api": "^8.2.0",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
