      "default": "./dist/child-termination-reporter.js"
    },
    "./wsl-distro-allowlist": {
      "markov-source": "./src/wsl-distro-allowlist.ts",
      "types": "./dist/wsl-distro-allowlist.d.ts",
      "default": "./dist/wsl-distro-allowlist.js"
    }
  },
  "scripts": {
    "build": "tsx --conditions=markov-source scripts/build-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "proper-lockfile": "4.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
