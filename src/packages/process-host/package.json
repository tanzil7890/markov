{
  "name": "@markov/process-host",
  "version": "0.0.0",
  "private": true,
  "description": "Markov host subprocess execution, cancellation, and termination",
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "main": "./dist/run-process.js",
  "types": "./dist/run-process.d.ts",
  "exports": {
    ".": {
      "markov-source": "./src/run-process.ts",
      "types": "./dist/run-process.d.ts",
      "default": "./dist/run-process.js"
    },
    "./process-spec": {
      "markov-source": "./src/process-spec.ts",
      "types": "./dist/process-spec.d.ts",
      "default": "./dist/process-spec.js"
    },
    "./isolated-detached-spawn": {
      "markov-source": "./src/isolated-detached-spawn.ts",
      "types": "./dist/isolated-detached-spawn.d.ts",
      "default": "./dist/isolated-detached-spawn.js"
    },
    "./fork-process": {
      "markov-source": "./src/fork-process.ts",
      "types": "./dist/fork-process.d.ts",
      "default": "./dist/fork-process.js"
    },
    "./process-tree-termination": {
      "markov-source": "./src/process-tree-termination.ts",
      "types": "./dist/process-tree-termination.d.ts",
      "default": "./dist/process-tree-termination.js"
    },
    "./windows-tree-kill": {
      "markov-source": "./src/windows-tree-kill.ts",
      "types": "./dist/windows-tree-kill.d.ts",
      "default": "./dist/windows-tree-kill.js"
    },
    "./process-tree-kill-gate": {
      "markov-source": "./src/process-tree-kill-gate.ts",
      "types": "./dist/process-tree-kill-gate.d.ts",
      "default": "./dist/process-tree-kill-gate.js"
    },
    "./spawn-observer": {
      "markov-source": "./src/spawn-observer.ts",
      "types": "./dist/spawn-observer.d.ts",
      "default": "./dist/spawn-observer.js"
    },
    "./bounded-output-sink": {
      "markov-source": "./src/bounded-output-sink.ts",
      "types": "./dist/bounded-output-sink.d.ts",
      "default": "./dist/bounded-output-sink.js"
    },
    "./growing-byte-buffer": {
      "markov-source": "./src/growing-byte-buffer.ts",
      "types": "./dist/growing-byte-buffer.d.ts",
      "default": "./dist/growing-byte-buffer.js"
    },
    "./windows-command-line": {
      "markov-source": "./src/windows-command-line.ts",
      "types": "./dist/windows-command-line.d.ts",
      "default": "./dist/windows-command-line.js"
    },
    "./windows-system-binary": {
      "markov-source": "./src/windows-system-binary.ts",
      "types": "./dist/windows-system-binary.d.ts",
      "default": "./dist/windows-system-binary.js"
    },
    "./windows-cmd-shim-resolution": {
      "markov-source": "./src/windows-cmd-shim-resolution.ts",
      "types": "./dist/windows-cmd-shim-resolution.d.ts",
      "default": "./dist/windows-cmd-shim-resolution.js"
    },
    "./posix-lsof-probe": {
      "markov-source": "./src/posix-lsof-probe.ts",
      "types": "./dist/posix-lsof-probe.d.ts",
      "default": "./dist/posix-lsof-probe.js"
    },
    "./retryable-process-exit-proof": {
      "markov-source": "./src/retryable-process-exit-proof.ts",
      "types": "./dist/retryable-process-exit-proof.d.ts",
      "default": "./dist/retryable-process-exit-proof.js"
    },
    "./cancel-process-acquisition": {
      "markov-source": "./src/cancel-process-acquisition.ts",
      "types": "./dist/cancel-process-acquisition.d.ts",
      "default": "./dist/cancel-process-acquisition.js"
    },
    "./close-process-registry": {
      "markov-source": "./src/close-process-registry.ts",
